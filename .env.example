# ==============================================================================
# MOKAFOR GLOBAL EDUCATION - VERCEL & SUPABASE ENVIRONMENT VARIABLES
# ==============================================================================

# 1. DATABASE CONFIGURATION (Supabase / PostgreSQL)
# ------------------------------------------------------------------------------
# Transaction / Pooled URL (Port 6543) - Used for runtime app database queries
DATABASE_URL="postgres://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct URL (Port 5432) - Used for Prisma schema migrations and CLI commands
DIRECT_URL="postgres://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# 2. PAYSTACK PAYMENT INTEGRATION
# ------------------------------------------------------------------------------
PAYSTACK_SECRET_KEY="your_paystack_secret_key_here"
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="your_paystack_public_key_here"

# 3. APPLICATION DOMAIN & URLS
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="https://www.mokafor.com"

# 4. EXECUTIVE ADMIN PORTAL
# ------------------------------------------------------------------------------
ADMIN_EMAIL="idconsultingltd@gmail.com"
